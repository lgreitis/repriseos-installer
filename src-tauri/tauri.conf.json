{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepriseOS Installer",
  "version": "0.1.1",
  "identifier": "com.lukasgreicius.repriseos.installer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RepriseOS Installer",
        "width": 1600,
        "height": 900,
        "minWidth": 800,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBNUE4RjU4OUI4QUQ0OTUKUldTVjFJcWJXSTlhZW8rUE5WY2lvTDh6MitYdFJRRjZEZjRyWVJOL2JQbG9BOGNNSGM1MTJmbGQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
